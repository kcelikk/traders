# Kopyala: cp .env.example .env
# .env asla repoya girmez. Faz 0'da anahtar gerekmez, alanlar boş kalır.
# Canlı/testnet için: çekim yetkisi KAPALI, IP whitelist AÇIK olmalı.
FBOT_MODE=paper

# --- Testnet (Faz 9, ADR 0015) ---
# testnet.binancefuture.com üzerinden oluşturulur. Üç kapı birden gerekir:
#   1) FBOT_TESTNET_ARMED dolu   2) anahtar çifti   3) config mode="testnet"
# Anahtar yalnızca burada durur; loga, kayda, image'a yazılmaz.
FBOT_TESTNET_ARMED=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Canlı (Faz 10) — kullanılmıyor; ayrı ADR ve açık onay gerekir ---
# Çekim yetkisi KAPALI, IP whitelist AÇIK olmadan doldurulmaz.
BINANCE_API_KEY=
BINANCE_ED25519_PRIVATE_KEY_PATH=
